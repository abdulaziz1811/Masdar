        "description": "عدد المساكن المتصلة بالكهرباء معبرا عنه كنسبة مئوية من إجمالي المساكن / The percentage of households that connected to electricity, which can be expressed by percentage of the total number of households",
        "parameters": [
          {
            "name": "dimensions[]",
            "in": "query",
            "style": "form",
            "explode": true,
            "description": "Group data by any of these dimensions. You can only filter and order the data if the corresponding dimension is selected.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ELECTRICITY_NETWORK_TYPE",
                  "HOUSE_TYPE",
                  "POSSESSION_TYPE",
                  "REGION",
                  "YEAR"
