            "description": "Filter data based on the value of POSSESSION_TYPE_ENGL",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "REGION_CODE",
            "in": "query",
            "description": "Filter data based on the value of REGION_CODE",
            "schema": {
              "type": "string"
            }
