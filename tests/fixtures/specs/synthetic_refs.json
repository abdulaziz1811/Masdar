      "get": {
        "summary": "متوسط الأسعار حسب المنطقة / Price averages by region",
        "parameters": [
          {
            "$ref": "#/components/parameters/Dims"
          },
          {
            "$ref": "#/components/parameters/QuarterTime"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/v1/stats/{datasetId}": {
      "get": {
        "summary": "generic / generic"
      }
    }
  },
  "components": {
