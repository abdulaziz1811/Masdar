        "schema": {
          "$ref": "#/components/schemas/DimList"
        }
      },
      "QuarterTime": {
        "name": "QUARTER_TIME",
        "in": "query",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
