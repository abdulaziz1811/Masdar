{
  "openapi": "3.0.1",
  "info": {
    "title": "إحصاءات الأسعار / Prices Statistics",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://evil.example.com"
    }
  ],
  "paths": {
