          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Row"
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "k": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "x-example-apikey": "ENU4fakefakefakefakefake0000"
      }
    }
  }
