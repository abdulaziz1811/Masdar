# Copy to .env and fill in. .env is gitignored: never commit real values.
#
# Credentials belong in the environment, not in the repository. Masdar reads
# them at call time and never logs or writes them.

# Outside the Kingdom (MASDAR_OUTSIDE_KSA=1), a Firecrawl key gives the national
# open-data platform (open.data.gov.sa) a Saudi exit; every other source stays
# direct. Key from https://www.firecrawl.dev (API Keys). A credit a request.
# FIRECRAWL_API_KEY=
# To send every fetch through Firecrawl instead (slower, costs more):
# MASDAR_HTTP_BACKEND=firecrawl

# GASTAT developer-portal credentials, for the key-based API gateway.
# Issued at the GASTAT developer portal under "تطبيقاتي".
# Rotate these if they are ever pasted anywhere outside this file.
# GASTAT_API_KEY=
# GASTAT_API_SECRET=

# Where downloaded files are cached (default: ~/.cache/masdar).
# MASDAR_CACHE_DIR=

# How long a cached source response may stand in for the source, in hours
# (default 6). 0 = always ask the source. Offline runs ignore the limit.
# MASDAR_CACHE_MAX_AGE_HOURS=6

# Optional: a language model reads questions the rule-based parser cannot
# place. Only those questions are sent out. Either key works:
#   Gemini (free tier; key from https://aistudio.google.com/apikey):
# GEMINI_API_KEY=
#   Claude (pip install -e '.[ai]'; key from platform.claude.com):
# ANTHROPIC_API_KEY=
# With both set, Gemini is used unless MASDAR_LLM_PROVIDER=claude.
# MASDAR_LLM_PROVIDER=gemini
# MASDAR_LLM_MODEL=gemini-3.8-flash
# MASDAR_LLM=off

# If a source cannot be reached, answer from its last saved copy up to this
# many days old (default 90), clearly labelled as a saved copy. 0 = never.
# MASDAR_STALE_MAX_DAYS=90

# Required before opening the chat to other machines or hosting it: the page
# asks for this code before the first question.
# MASDAR_ACCESS_CODE=
